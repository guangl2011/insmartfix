{
  "name": "@insmartfix/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:coverage": "jest --ci --coverage",
    "e2e": "maestro test e2e"
  },
  "dependencies": {
    "@expo/log-box": "58.0.14",
    "@expo/metro-runtime": "58.0.16",
    "@insmartfix/contracts": "workspace:*",
    "@insmartfix/core": "workspace:*",
    "@insmartfix/tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.28.0",
    "expo": "58.0.22",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "msw": "2.15.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-url-polyfill": "3.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.23",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "react-refresh": "0.14.2",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@insmartfix/.*|standard-navigation|rettime|until-async|@open-draft/deferred-promise))"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "src/**/*.{ts,tsx}",
      "!app/_layout.tsx"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 75
      }
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "transform": {
      "^.+\\.mjs$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.ts"
    ]
  }
}
