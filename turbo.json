{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "NEXT_TELEMETRY_DISABLED",
    "EXPO_NO_TELEMETRY",
    "DO_NOT_TRACK",
    "TURBO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATA_SOURCE", "API_BASE_URL", "NEXT_PUBLIC_*", "NEXT_OUTPUT", "EXPO_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATA_SOURCE", "API_BASE_URL"]
    }
  }
}
