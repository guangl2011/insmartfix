# InsmartFix local-stack / CI configuration. DEV-ONLY placeholder values — never real secrets.
# `make up` copies this to infra/.env if it does not exist. Staging/production values live only in
# the GitHub `staging` / `production` environments.

# --- Postgres (container) ---
POSTGRES_USER=insmartfix
POSTGRES_PASSWORD=insmartfix-dev-only
POSTGRES_DB=insmartfix
POSTGRES_HOST_PORT=55432

# --- API ---
# ENV has no default in the API (D10 H-7). FAKE_CLOCK=1 is only accepted with ENV=local|test|ci.
ENV=local
# The app connects with DATABASE_URL as the least-privilege runtime role insmartfix_app (created by
# infra/postgres/init on a fresh volume; run `make down` once if your volume predates it). Migrations
# use MIGRATIONS_DATABASE_URL, the schema owner (D10 H-5).
APP_DB_PASSWORD=insmartfix-app-dev-only
DATABASE_URL=postgresql+psycopg://insmartfix_app:insmartfix-app-dev-only@postgres:5432/insmartfix
MIGRATIONS_DATABASE_URL=postgresql+psycopg://insmartfix:insmartfix-dev-only@postgres:5432/insmartfix
# NFR-6 requires >= 256 bits; this dev placeholder is public and must never be used outside local/CI.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000
FAKE_CLOCK=1
CORS_ORIGINS=["http://localhost:3000"]
API_HOST_PORT=8000

# --- Seed (make seed) ---
# Test-account password for the TEST_PLAN §5 fixtures. Never committed: export SEED_PASSWORD in your
# shell before `make seed` (CI generates one per run; staging uses its environment secret).

# --- Object storage (MinIO stands in for S3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=insmartfix-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=insmartfix-dev
S3_SECRET_ACCESS_KEY=insmartfix-dev-only
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Web ---
DATA_SOURCE=live
API_BASE_URL=http://api:8000
WEB_HOST_PORT=3000

# --- Toxiproxy (resilience tests) ---
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
TOXIPROXY_HOST_PORT=8474
TOXIPROXY_API_PROXY_HOST_PORT=18000
TOXIPROXY_PG_PROXY_HOST_PORT=15432
