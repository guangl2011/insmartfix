{
  "name": "@insmartfix/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "openapi.json exported from apps/api, generated TS types and a typed fetch client.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json",
    "./mocks": "./mocks/index.ts"
  },
  "scripts": {
    "export": "uv run --directory ../../apps/api --frozen python -m app.export_openapi ../../packages/contracts/openapi.json",
    "generate:types": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "generate": "pnpm run export && pnpm run generate:types",
    "check": "node ./scripts/check-drift.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "msw": "2.15.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "vitest": "4.1.12"
  }
}
